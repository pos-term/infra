types {
    text/plain yaml;
    text/plain yml;
}

gzip on;
gzip_static on;
gzip_vary on;
gzip_types text/plain text/css application/javascript;

map $request_method $access_control_max_age {
    OPTIONS 1728000;
}
server_tokens off;

server {
    listen $PORT;
    server_name localhost;
    index index.html index.htm;

    # Resolve through Docker DNS so the proxy follows processor container replacements.
    resolver 127.0.0.11 valid=10s ipv6=off;
    location ~ ^/(v1/|healthz$) {
        set $processor_upstream http://payment-processor:8080;
        proxy_pass $processor_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }

    location $BASE_URL {
        absolute_redirect off;
        alias /usr/share/nginx/html/;
        expires 1d;

        location ~ swagger-initializer.js {
            expires -1;
            include templates/cors.conf;
        }

        location ~* \.(?:json|yml|yaml)$ {
            #SWAGGER_ROOT
            expires -1;
            include templates/cors.conf;
        }

        include templates/cors.conf;
        include templates/embedding.conf;
    }
}
