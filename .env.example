# Address at which Kafka is reachable from outside compose: from the host and from a Raspberry Pi.
# For local work on the same machine keep localhost.
# For a terminal on a Pi, set the IP or hostname of the machine running compose (e.g. 192.168.1.50).
KAFKA_EXTERNAL_HOST=localhost

# Postgres password for local/test use only. Change it if this compose is ever reachable from outside localhost.
POSTGRES_PASSWORD=pos
